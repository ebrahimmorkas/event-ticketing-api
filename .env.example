NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=*

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ticketing?schema=public

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Redis (optional) — when disabled the app falls back to in-memory cache,
# in-memory rate limiting and an in-process job scheduler.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Bookings
BOOKING_HOLD_MINUTES=10

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
